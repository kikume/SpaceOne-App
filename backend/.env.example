# ============================================================
# CryptoVault Backend — Variáveis de Ambiente
# Copie para .env e preencha. O servidor é "cego": não há
# chaves de blockchain nem nada que descriptografe as seeds.
# ============================================================

NODE_ENV=development
PORT=3001

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:SUASENHA@localhost:5432/cryptovault

# ── JWT (sessões) ────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=MUDE_PARA_64_BYTES_ALEATORIOS

# ── Chaves de servidor ───────────────────────────────────────
# Gere CADA UMA com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOTP_ENC_KEY: cifra o segredo do 2FA em repouso (32 bytes hex = 64 chars)
# PARAMS_PEPPER: gera salts-isca para impedir enumeração de emails
TOTP_ENC_KEY=MUDE_PARA_32_BYTES_HEX
PARAMS_PEPPER=MUDE_PARA_32_BYTES_HEX

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
