# ============================================================
# CryptoVault Backend — Variáveis de Ambiente
# COPIE este arquivo para .env e preencha os valores
# ============================================================

NODE_ENV=development
PORT=3001

# ── PostgreSQL ───────────────────────────────────────────────
# Local:   postgresql://postgres:suasenha@localhost:5432/cryptovault
# Render:  Será fornecido automaticamente ao criar o banco
DATABASE_URL=postgresql://postgres:SUASENHA@localhost:5432/cryptovault

# ── JWT ──────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=MUDE_ISSO_PARA_UMA_STRING_ALEATORIA_FORTE_DE_64_CHARS

# ── Blockchain ───────────────────────────────────────────────
# Chave privada da carteira mestre (paga o gás das transações)
# ATENÇÃO: Esta carteira precisa ter AVAX na testnet Fuji
# Consiga AVAX grátis em: https://faucet.avax.network/
MASTER_PRIVATE_KEY=0xSUA_CHAVE_PRIVADA_AQUI

# Endereço do smart contract já implantado
CONTRACT_ADDRESS=0x3Eb2b227d0f7aC2bFf07d3A617b2d9A04e2d91EeE

# RPC da rede Avalanche Fuji Testnet
RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# ── CORS ─────────────────────────────────────────────────────
# Em produção: URL do seu frontend (Netlify/Vercel)
# Em dev: http://localhost:3000
FRONTEND_URL=http://localhost:3000
